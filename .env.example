# Solo nombres de variables. Los valores se ponen en cada entorno, nunca aquí.
# En 1 el sitio pide no ser indexado: meta noindex, robots.txt con Disallow y sitemap vacío.
SITE_NOINDEX=
# Dirección pública del sitio; el sitemap la usa cuando no está en modo noindex.
SITE_URL=
# Cadena de conexión de Neon (la del pooler de cada entorno). Cada entorno usa la suya.
DATABASE_URL=
# Correo del mensajero (SMTP de Gmail con contraseña de aplicación). La contraseña solo va en el archivo de entorno o en el hosting.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Dirección que recibe los mensajes.
MAIL_TO=
# Secretos propios de cada entorno del mensajero: firma del tiempo mínimo y sal de la huella del IP.
FORM_SECRET=
IP_SALT=
